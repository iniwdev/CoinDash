# Frontend Environment Variables
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────────────────────────────────────
# API Base URL
# Development: Vite dev server proxies /api → http://localhost:8000
# Production:  Set to your deployed backend URL (e.g. https://api.coindash.app)
# ─────────────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ─────────────────────────────────────────────────────────────────────────────
# CoinStats API Key (optional – only needed if you use CoinStats as a data source)
# Get yours at: https://openapi.coinstats.app/
# Leave empty to use the free CoinGecko proxy only
# ─────────────────────────────────────────────────────────────────────────────
VITE_COINSTATS_API_KEY=
