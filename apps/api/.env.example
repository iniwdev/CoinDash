# =============================================================================
#  CoinDash AI — Backend Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg driver — required for SQLAlchemy async + Alembic
DATABASE_URL=postgresql+asyncpg://coindash:coindash_dev_password@localhost:5432/coindash

# ── Redis ─────────────────────────────────────────────────────────────────────
# Cache + pub/sub. DB index 0 = default.
REDIS_URL=redis://localhost:6379/0

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_USE_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
# Token lifetime in minutes (10080 = 7 days)
JWT_EXPIRE_MINUTES=10080

# ── External APIs ─────────────────────────────────────────────────────────────
# Groq — used by AI/LLM features (Phase 5+). Leave blank to disable AI routes.
GROQ_API_KEY=

# CoinStats — market data provider. Get your key at https://coinstats.app/
COINSTATS_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Server ────────────────────────────────────────────────────────────────────
# app_env: "development" | "staging" | "production"
APP_ENV=development
# debug=true enables SQL query logging and verbose startup output
DEBUG=true
